{
  "name": "hotmess.social",
  "private": true,
  "type": "module",
  "description": "hotmess.social: the Hot Mess web app and marketing site, built on AudienceKit.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "test": "node --test --experimental-strip-types src/lib/*.test.ts src/sdk/*.test.ts",
    "e2e": "playwright test --project=app",
    "e2e:live": "E2E_SUITE=live playwright test --project=live"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/react": "^7.0.1",
    "astro": "^7.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
