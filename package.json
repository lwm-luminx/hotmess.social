{
  "name": "hotmess.social",
  "private": true,
  "type": "module",
  "description": "hotmess.social: the Hot Mess web app and marketing site, built on AudienceKit.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "npm run build && wrangler dev",
    "test": "node --test --experimental-strip-types src/lib/*.test.ts src/sdk/*.test.ts edge/src/*.test.ts",
    "e2e": "playwright test --project=app",
    "e2e:live": "E2E_SUITE=live playwright test --project=live",
    "generate-types": "wrangler types",
    "deploy": "npm run build && wrangler deploy"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.4.2",
    "@astrojs/react": "^7.0.1",
    "@lwm-luminx/astro-components": "file:vendor/lwm-luminx-astro-components-0.2.0.tgz",
    "astro": "^7.3.5",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "wrangler": "4.152.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "wrangler": "^4.152.0"
  }
}
