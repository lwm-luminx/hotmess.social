# Public values baked into the browser bundle. Never put secrets here:
# everything prefixed PUBLIC_ ships to every visitor.
PUBLIC_API_BASE=https://api.audiencekit.com
PUBLIC_FACEBOOK_APP_ID=1168782378316790
PUBLIC_AUDIENCE_HOST=hotmess.admin.audiencekit.com
# Sign in with Apple JS; empty leaves Apple off.
PUBLIC_APPLE_SERVICES_ID=social.hotmess.signin
# A staging deployment points PUBLIC_API_BASE at https://api.next.audiencekit.com,
# PUBLIC_AUDIENCE_HOST at hotmess.admin.next.audiencekit.com and PUBLIC_FACEBOOK_APP_ID at the
# staging app; the API picks the environment from the host, so nothing else is needed.
