---
// Apple's "Download on the App Store" and Google's "Get it on Google Play" badges, linking to each store's listing.
// Artwork is the stores' own (public/badges/), shown at the same height as their guidelines ask.
import { APP_STORE_URL, PLAY_STORE_URL } from '../lib/download';
---
<div class="badges">
  <a href={APP_STORE_URL}><img src="/badges/app-store.svg" alt="Download on the App Store" width="144" height="48" /></a>
  <a href={PLAY_STORE_URL}><img src="/badges/google-play.png" alt="Get it on Google Play" width="161" height="48" /></a>
</div>

<style>
  .badges { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem; }
  .badges a { display: block; line-height: 0; border-radius: 8px; }
  .badges img { height: 48px; width: auto; }
</style>
