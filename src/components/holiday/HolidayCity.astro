---
// One city's holiday food page, made to be shared: the free holiday meals listed for the city (community resources named
// "<Holiday> meal: …", read live like /resources/<city>), then the rest of its free food and how to find it on Hot
// Mess. Meals are hidden in the API after the holiday, so afterwards this shows the year-round food only.
import Base from '../../layouts/Base.astro';
import HolidayHowTo from './HolidayHowTo.astro';
import { BADGES, checkedText, citySlug, dialHref, emergencyNumber, kinds, phoneText, slotText, urgentFirst,
  type ResourceDirectory, type ResourceLocale } from '../../lib/communityResources';
import { eventStillOn, eventWhen, HOLIDAYS, holidayMeals, holidayNow, priceText, otherFood, type Holiday } from '../../lib/holidayGuide';
import { listing } from '../../server/publicContent';
import type { PublicListing } from '../../lib/publicListing';
import holidayEvents from '../../data/holiday-events.json';
interface Props { holiday: Holiday; directory: ResourceDirectory | null; city: ResourceLocale | undefined; status: number }
const { directory, city, status } = Astro.props;
// Once the holiday is over the page stops saying "today" and drops the events that have finished.
const holiday = holidayNow(Astro.props.holiday);
const next = holiday.over && holiday.next ? HOLIDAYS[holiday.next] : undefined;
const name = directory?.locale.name ?? city?.name ?? 'your city';
const meals = directory ? holidayMeals(directory.resources, holiday) : [];
const food = directory ? urgentFirst(otherFood(directory.resources)) : [];
const foodHref = city ? `/resources/${citySlug(city)}?need=food` : '/resources';
const emergency = city ? emergencyNumber(city) : null;
const maps = (address: string) => `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`;
// Holiday events at the city's Hot Mess venues (imported and tagged for the holiday; their ids are in
// src/data/holiday-events.json), read live from the public listing so a cancellation shows. One that fails is skipped.
const eventIds: string[] = city
  ? ((holidayEvents as Record<string, Record<string, string[]>>)[holiday.slug]?.[citySlug(city)] ?? []) : [];
const events = (await Promise.all(eventIds.map((id) => listing(`events/${id}`).catch(() => null))))
  .filter((e): e is PublicListing => !!e && e.kind === 'event' && !e.is_canceled && eventStillOn(e.start_at, e.end_at))
  .sort((a, b) => (a.start_at ?? '').localeCompare(b.start_at ?? ''));
const multiDay = Object.keys(holiday.days).length > 0;
const dayOf = (i: number) => (multiDay && meals[i].day && meals[i].day !== meals[i - 1]?.day ? meals[i].day : null);
---
<Base title={`Free food in ${name} this ${holiday.name}`} calm noindex={status !== 200} image={new URL(`/og/${holiday.slug}.png`, Astro.site).toString()}
  description={meals.length > 0
    ? `${meals.length} free ${holiday.name} ${meals.length === 1 ? 'meal' : 'meals'} in ${name}, plus food pantries and meal programs near you.`
    : `Free food in ${name}: pantries, meal programs and what's open on the holiday.`}>
  <main>
    <section class="poster">
      <div class="wrap">
        <p class="date">{holiday.dateLine}</p>
        <h1>Free food in {name} this {holiday.name}</h1>
        <p class="lede">{holiday.lede}</p>
        {next && <p class="other"><a href={city ? `/${next.slug}/${citySlug(city)}` : `/${next.slug}`}>Free food this {next.name}</a></p>}
        <p class="other"><a href={`/${holiday.slug}?pick`}>Not in {name}? Pick your city</a></p>
      </div>
    </section>

    {status === 404 && <p class="wrap note card">We don’t have a food list for that city yet. <a href={`/${holiday.slug}?pick`}>See every city</a>.</p>}
    {status === 503 && <p class="wrap note card">We couldn’t load {name} just now. Try again in a minute.</p>}

    {events.length > 0 && (
      <section class="wrap events" aria-labelledby="events-title">
        <h2 id="events-title">{holiday.name} at {name}’s queer bars and venues</h2>
        <p class="muted">Spend the holiday with your people. Times and prices come from each venue’s own posts, so check with them before you go.</p>
        {events.map((e) => (
          <article class="card event">
            {e.image && <img src={e.image} alt="" loading="lazy" />}
            <div>
              {eventWhen(e.start_at, e.end_at, city?.timeZone ?? null) && <p class="time small-time">{eventWhen(e.start_at, e.end_at, city?.timeZone ?? null)}</p>}
              <h3>{e.title}</h3>
              <p class="price">{priceText(e.cover_cents)}</p>
              {e.venue_name && <p class="venue">{e.venue_name}</p>}
              {e.address && <p class="where">{e.address}</p>}
              {e.description && <p class="desc">{e.description.length > 280 ? `${e.description.slice(0, 277)}…` : e.description}</p>}
              <p class="actions">
                {e.address && <a class="button" href={maps(e.address)} rel="noopener noreferrer" target="_blank">Directions</a>}
                {e.ticket_url && <a class="button secondary" href={e.ticket_url} rel="noopener noreferrer" target="_blank">Venue’s post</a>}
                <a class="button secondary" href={e.path}>See it on Hot Mess</a>
              </p>
            </div>
          </article>
        ))}
      </section>
    )}

    {directory && (
      <section class="wrap meals" aria-labelledby="meals-title">
        <h2 id="meals-title">{meals.length > 0 ? holiday.mealsTitle : 'Free food near you'}</h2>
        {meals.length === 0 && <p>{holiday.noMeals(name)}</p>}
        {meals.map((m, i) => (<>
          {dayOf(i) && <h3 class="day">{dayOf(i)}</h3>}
          <article class="card meal">
            {m.time && <p class="time">{m.time}</p>}
            <h3>{m.org}</h3>
            {m.address && <p class="where">{m.address}</p>}
            {m.intakeNote && <p class="who">{m.intakeNote}</p>}
            <p class="actions">
              {m.phone && <a class="button" href={dialHref(m.phone)}>Call {phoneText(m.phone)}</a>}
              {m.address && <a class="button secondary" href={maps(m.address)} rel="noopener noreferrer" target="_blank">Directions</a>}
              {m.url && <a class="button secondary" href={m.url} rel="noopener noreferrer" target="_blank">Details</a>}
            </p>
          </article>
        </>))}
        {food.length > 0 && <h2 class="sub">{meals.length > 0 ? `More free food in ${name}` : `Free food in ${name}`}</h2>}
        {food.map((r) => (
          <article class="card place">
            {kinds(r).length > 0 && <p class="kind">{kinds(r).join(' · ')}</p>}
            <h3>{r.title}</h3>
            {r.description && <p>{r.description}</p>}
            {r.facets.some((f) => BADGES[f]) && (
              <p class="badges">{r.facets.filter((f) => BADGES[f]).map((f) => <span class="badge">{BADGES[f]}</span>)}</p>
            )}
            <p class="actions">
              {r.phone && <a class="button" href={dialHref(r.phone)}>Call {phoneText(r.phone)}</a>}
              {r.address && !r.sensitive && <a class="button secondary" href={maps(r.address)} rel="noopener noreferrer" target="_blank">Directions</a>}
              {r.url && <a class="button secondary" href={r.url} rel="noopener noreferrer" target="_blank">Website</a>}
            </p>
            {r.intakeNote && <p class="who">{r.intakeNote}</p>}
            {r.hours.length + r.sessions.length > 0 && <ul class="slots">{[...r.hours, ...r.sessions].map((x) => <li>{slotText(x)}</li>)}</ul>}
            {r.address && <p class="where small">{r.address}</p>}
            <p class="where small">{checkedText(r.checkedAt) ? `${checkedText(r.checkedAt)}.` : 'Not checked by us yet.'} Holiday hours may differ, so call ahead.</p>
          </article>
        ))}
        <p class="muted small">Shelter, health and other help in {name}: <a href={city ? `/resources/${citySlug(city)}` : '/resources'}>see everything</a>.</p>
        <p class="urgent">In danger right now? {emergency ? <a href={`tel:${emergency}`}>Call {emergency}</a> : <>Call your local emergency number</>}. For food, housing or other help any time in the US, call <a href="tel:211">211</a>.</p>
      </section>
    )}


    <HolidayHowTo foodHref={foodHref} cityName={directory ? name : undefined} />
    <p class="wrap muted fine">Gathered from public sources and {holiday.checked}. Hot Mess isn’t part of any of these organizations. Hot Mess is not an emergency service.</p>
  </main>
</Base>

<style>
  .poster { color: var(--on-accent); background: var(--accent); padding: clamp(2rem, 7vw, 4.5rem) 0 clamp(1.75rem, 5vw, 3rem);
    background-image: radial-gradient(110% 80% at 100% 0%, color-mix(in srgb, var(--accent-strong) 70%, transparent), transparent 60%); }
  .poster .date { margin: 0 0 .75rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; font-size: .85rem; opacity: .9; }
  .poster h1 { font-size: clamp(2.3rem, 8vw, 4.6rem); font-weight: 900; line-height: 1.02; margin: 0 0 1rem; max-width: 14ch; text-wrap: balance; }
  .poster .lede { font-size: clamp(1.05rem, 2.4vw, 1.3rem); margin: 0 0 1rem; max-width: 46ch; }
  .poster .other { margin: 0; }
  .poster .other + .other { margin-top: .4rem; }
  .poster a { color: inherit; font-weight: 600; }
  .note { margin-top: 1.5rem; padding: 1rem 1.25rem; }
  .meals { display: grid; gap: 1rem; padding-top: 2rem; max-width: 46rem; }
  .meals h2 { font-size: clamp(1.5rem, 4vw, 2rem); margin: 0; }
  .meals > p { margin: 0; }
  .day { margin: .75rem 0 0; font-size: 1.1rem; text-transform: uppercase; letter-spacing: .06em; color: var(--ink-muted); }
  .meal { padding: 1.25rem; display: grid; gap: .35rem; }
  .meal .time { margin: 0; font-size: 1.6rem; font-weight: 800; color: var(--accent); font-variant-numeric: tabular-nums; }
  .meal h3 { margin: 0; font-size: 1.3rem; }
  .meal p { margin: 0; }
  .where { color: var(--ink-muted); }
  .who { font-style: italic; }
  .actions { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .6rem !important; }
  .sub { font-size: 1.35rem; margin: 1rem 0 0; }
  .place { padding: 1.25rem; display: grid; gap: .4rem; }
  .place h3 { margin: 0; font-size: 1.2rem; }
  .place p { margin: 0; }
  .kind { font-size: .8rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--ink-muted); }
  .badges { display: flex; flex-wrap: wrap; gap: .4rem; }
  .badge { font-size: .8rem; padding: .15rem .55rem; border-radius: 999px; background: var(--accent-soft); }
  .slots { margin: .2rem 0; padding-left: 1.1rem; }
  .small { font-size: .9rem; }
  .more { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1rem 1.25rem; text-decoration: none; color: inherit; }
  .more > span:first-child { display: grid; gap: .15rem; }
  .more:hover strong { text-decoration: underline; }
  .urgent { padding: .75rem 1rem; border-radius: var(--radius); background: var(--surface-raised); border: 1px solid var(--border); border-inline-start: 4px solid var(--accent); }
  .urgent a { font-weight: 700; white-space: nowrap; }
  .events { display: grid; gap: 1rem; padding-top: 2rem; max-width: 46rem; }
  .events h2 { font-size: clamp(1.5rem, 4vw, 2rem); margin: 0; }
  .events > p { margin: 0; }
  .event { padding: 1.25rem; display: grid; grid-template-columns: minmax(0, 1fr); gap: 1rem; }
  .event img { width: 100%; max-height: 220px; object-fit: cover; border-radius: calc(var(--radius) - 4px); }
  .event div { display: grid; gap: .35rem; min-width: 0; }
  .event h3 { margin: 0; font-size: 1.25rem; }
  .event p { margin: 0; }
  .price { font-weight: 700; }
  .venue { font-weight: 600; }
  .small-time { font-size: 1.1rem !important; font-weight: 800; color: var(--accent); margin: 0; }
  .fine { font-size: .9rem; padding-bottom: 3rem; }
</style>
