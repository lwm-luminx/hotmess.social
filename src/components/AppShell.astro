---
// The client-side Hot Mess app (src/app/App.tsx), a React island built from the AudienceKit
// components in src/sdk. It renders /app/ and, through the 404 page, the share links
// /venues/<id>, /events/<id> and /people/<id>, which GitHub Pages cannot route statically.
import App from '../app/App';
---
<main class="wrap app" id="app" aria-live="polite">
  <App client:only="react">
    <p slot="fallback" class="muted">Loading…</p>
  </App>
</main>

<style is:global>
  .app { padding-top: 1.5rem; min-height: 50vh; }
  .app-account { display: flex; justify-content: flex-end; margin-bottom: 1rem; }
  .signin { max-width: 420px; margin: 2rem auto; padding: 1.5rem; }
  .signin h1 { margin-top: 0; }
  .signin-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .signin-methods { display: grid; gap: 0.75rem; }
  .signin-methods .button { justify-content: center; }
  /* Apple's button style: black on light pages, white on dark. */
  .button.apple { background: #000; color: #fff; }
  .button.apple:hover { background: #222; }
  @media (prefers-color-scheme: dark) {
    .button.apple { background: #fff; color: #000; }
    .button.apple:hover { background: #e8e8e8; }
  }
  .error { color: var(--danger); }
</style>
