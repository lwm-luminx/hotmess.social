---
// Public basics render on the server; authenticated details load only after hydration.
import App from '../app/App';
import type { PublicListing } from '../lib/publicListing';
interface Props { initialPath?: string; publicListing?: PublicListing; expired?: boolean }
const { initialPath = Astro.url.pathname + Astro.url.search, publicListing, expired } = Astro.props;
---
<main class="wrap app" id="app" aria-live="polite">
  <App initialPath={initialPath} publicListing={publicListing} expired={expired} client:load />
</main>

<style is:global>
  .app { padding-top: 1.5rem; min-height: 50vh; }
  .app-account { display: flex; justify-content: flex-end; margin-bottom: 1rem; }
  .signin { max-width: 420px; margin: 2rem auto; padding: 1.5rem; }
  .signin h1 { margin-top: 0; }
  .signin-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .signin-methods { display: grid; gap: 0.75rem; }
  .signin-methods .button { justify-content: center; }
  /* Apple's button style: black on light pages, white on dark. */
  .button.apple { background: #000; color: #fff; }
  .button.apple:hover { background: #222; }
  @media (prefers-color-scheme: dark) {
    .button.apple { background: #fff; color: #000; }
    .button.apple:hover { background: #e8e8e8; }
  }
  .error { color: var(--danger); }
  .app-account { gap: 0.75rem; flex-wrap: wrap; }
  .small { font-size: 0.875rem; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* Get help (src/app/GetHelp.tsx): quiet surfaces, no red except 911. */
  .help-entry {
    display: flex; align-items: center; gap: 0.5rem; width: 100%; min-height: 44px; margin-bottom: 1rem; padding: 0 1rem;
    background: var(--surface-raised); border: 1px solid var(--border); border-radius: var(--radius);
    color: var(--ink-muted); font: 600 0.95rem "Figtree", system-ui, sans-serif; cursor: pointer;
  }
  .help-entry span:nth-of-type(1) { flex: 1; text-align: left; }
  .help-sheet { width: min(520px, 100% - 2 * var(--gutter)); max-height: calc(100dvh - 2rem); overflow-y: auto; padding: 1.25rem; color: var(--ink); }
  .help-sheet::backdrop { background: rgba(0, 0, 0, 0.45); }
  .help-page { max-width: 560px; margin: 0 auto; padding: 1.25rem; }
  .help-page-title { margin-top: 0; font-size: 1.4rem; }
  .help-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 0.75rem; }
  .help-head h2 { margin: 0; font-size: 1.2rem; }
  .help-rows { list-style: none; margin: 0 0 0.75rem; padding: 0; display: grid; gap: 0.5rem; }
  .help-row {
    display: grid; gap: 0.15rem; width: 100%; padding: 0.75rem 1rem; text-align: left; text-decoration: none;
    background: var(--surface-sunken); border: 0; border-radius: var(--radius); color: var(--ink);
    font: inherit; cursor: pointer;
  }
  .help-row-title { font-weight: 600; }
  .help-back { background: none; border: 0; padding: 0.25rem 0; margin-bottom: 0.5rem; color: var(--accent); font: 600 0.95rem "Figtree", system-ui, sans-serif; cursor: pointer; }
  .help-emergency { margin-top: 1rem; padding: 0.75rem 1rem; border-radius: var(--radius); background: color-mix(in srgb, var(--danger) 10%, var(--surface-raised)); }
  .help-emergency p { margin: 0.25rem 0; }
  .help-call { display: inline-block; font-weight: 700; color: var(--danger); font-size: 1.1rem; }
  .help-form h3, .help-section h3 { font-size: 1rem; margin: 1rem 0 0.5rem; }
  .help-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .help-chip {
    min-height: 36px; padding: 0 0.9rem; border-radius: 999px; border: 1px solid var(--border);
    background: var(--surface-sunken); color: var(--ink); font: 500 0.9rem "Figtree", system-ui, sans-serif; cursor: pointer;
  }
  .help-chip[aria-pressed="true"] { background: var(--accent-soft); border-color: var(--accent); font-weight: 600; }
  .help-label { display: block; font-weight: 600; margin: 1rem 0 0.5rem; }
  .help-form textarea, .help-reply input {
    width: 100%; padding: 0.6rem 0.75rem; border: 1px solid var(--border); border-radius: 10px;
    background: var(--surface-raised); color: var(--ink); font: inherit;
  }
  .help-submit { width: 100%; justify-content: center; margin-top: 0.5rem; }
  .help-section { border-top: 1px solid var(--border); padding-top: 0.5rem; margin-top: 0.75rem; }
  .help-steps { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.6rem; }
  .help-step { display: flex; gap: 0.75rem; align-items: flex-start; }
  .help-step.upcoming { color: var(--ink-muted); }
  .help-dot {
    flex: none; width: 24px; height: 24px; border-radius: 50%; display: grid; place-items: center;
    font-size: 0.8rem; font-weight: 700; background: var(--surface-sunken);
  }
  .help-step.done .help-dot { background: #2e7d4f; color: #fff; }
  .help-step.current .help-dot { background: var(--accent-soft); box-shadow: inset 0 0 0 2px var(--accent); }
  .help-thread { list-style: none; padding: 0; margin: 0 0 0.5rem; display: grid; gap: 0.5rem; }
  .help-thread li { display: grid; gap: 0.15rem; justify-items: start; }
  .help-thread li.mine { justify-items: end; }
  .help-bubble { padding: 0.5rem 0.75rem; border-radius: 16px; background: var(--surface-sunken); max-width: 85%; }
  .help-thread li.mine .help-bubble { background: var(--accent-soft); }
  .help-reply { display: flex; gap: 0.5rem; }
  .help-line { display: grid; gap: 0.2rem; padding: 0.75rem 1rem; background: var(--surface-sunken); border-radius: var(--radius); }
  .help-line-actions { display: flex; gap: 1rem; font-weight: 600; }
  .help-note { padding: 0.75rem 1rem; border-radius: var(--radius); background: var(--accent-soft); }
</style>
