---
// The client-side Hot Mess app. It renders /app/ and, through the 404 page,
// the share links /venues/<id>, /events/<id> and /people/<id>, which GitHub
// Pages cannot route statically.
---
<main class="wrap app" id="app" aria-live="polite">
  <p class="muted">Loading…</p>
</main>

<template id="signin">
  <section class="card signin">
    <h1>Sign in to Hot Mess</h1>
    <p class="muted">Hot Mess uses your Facebook account to find your friends and your city's scene.</p>
    <button class="button" type="button" data-action="signin">Continue with Facebook</button>
    <p class="error" role="alert" hidden></p>
  </section>
</template>

<script>
  import { api, session, APIError, type Event, type Venue } from '../lib/api';
  import { facebookAccessToken } from '../lib/facebook';
  import { routeFor, pathFor, type Route } from '../lib/routes';

  const root = document.getElementById('app')!;

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, props: Partial<HTMLElementTagNameMap[K]> = {}, ...children: (Node | string)[]) {
    const node = Object.assign(document.createElement(tag), props);
    node.append(...children);
    return node;
  }

  function show(...nodes: Node[]) { root.replaceChildren(...nodes); }

  function message(text: string) { show(el('p', { className: 'muted' }, text)); }

  const when = (iso: string) =>
    new Date(iso).toLocaleString(undefined, { weekday: 'short', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });

  function link(route: Route, ...children: (Node | string)[]) {
    const a = el('a', { href: pathFor(route) }, ...children);
    a.addEventListener('click', (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey) return;
      e.preventDefault();
      history.pushState(null, '', a.href);
      render();
    });
    return a;
  }

  function image(src: string | undefined, alt = '') {
    return src ? el('img', { src, alt, loading: 'lazy' }) : el('div', { className: 'placeholder' });
  }

  function venueRow(v: Venue) {
    return el('li', {}, link({ kind: 'venue', id: v.id }, image(v.photo_url ?? v.hero_url), el('span', {}, el('strong', {}, v.name), v.address ? el('small', { className: 'muted' }, v.address) : '')));
  }

  // Most events have no cover photo of their own (and Now doesn't send one), so show the venue's.
  function eventPhoto(e: Event) {
    return e.cover_photo_url ?? e.venue?.photo_url ?? e.venue?.hero_url;
  }

  function eventRow(e: Event) {
    return el('li', {}, link({ kind: 'event', id: e.id }, image(eventPhoto(e)), el('span', {}, el('strong', {}, e.name), el('small', { className: 'muted' }, [when(e.start_at), e.venue?.name].filter(Boolean).join(' · ')))));
  }

  function list(title: string, rows: HTMLLIElement[]) {
    return rows.length ? el('section', {}, el('h2', {}, title), el('ul', { className: 'rows' }, ...rows)) : el('span');
  }

  // The API picks the venue you're at, or your city, from where you are.
  function here(): Promise<{ latitude: number; longitude: number } | null> {
    if (!('geolocation' in navigator)) return Promise.resolve(null);
    return new Promise((resolve) => navigator.geolocation.getCurrentPosition(
      ({ coords }) => resolve({ latitude: coords.latitude, longitude: coords.longitude }),
      () => resolve(null),
      { maximumAge: 5 * 60 * 1000, timeout: 15000 },
    ));
  }

  function signIn() {
    const view = (document.getElementById('signin') as HTMLTemplateElement).content.cloneNode(true) as DocumentFragment;
    const button = view.querySelector('button')!;
    const error = view.querySelector('.error') as HTMLElement;
    button.addEventListener('click', async () => {
      button.disabled = true;
      error.hidden = true;
      try {
        session.token = (await api.signIn(await facebookAccessToken())).token;
        render();
      } catch (e) {
        error.textContent = e instanceof Error ? e.message : 'Sign-in failed';
        error.hidden = false;
        button.disabled = false;
      }
    });
    show(view);
  }

  async function render() {
    const route = routeFor(location.pathname);
    if (!route) return message("That page doesn't exist.");
    if (!session.token) return signIn();

    message('Loading…');
    try {
      switch (route.kind) {
        case 'now': {
          const position = await here();
          if (!position) return message('Hot Mess shows what\'s happening around you. Allow location access for hotmess.social and reload.');
          const now = await api.now(position.latitude, position.longitude);
          const venues = now.venues ?? (now.venue ? [now.venue] : []);
          document.title = 'Now · Hot Mess';
          return show(el('h1', {}, now.title ?? 'Now'), list('Tonight', (now.events ?? []).map(eventRow)), list('Venues', venues.map(venueRow)));
        }
        case 'venue': {
          const [venue, events] = await Promise.all([api.venue(route.id), api.venueEvents(route.id)]);
          document.title = `${venue.name} · Hot Mess`;
          return show(image(venue.hero_url ?? venue.photo_url, venue.name), el('h1', {}, venue.name), venue.address ? el('p', { className: 'muted' }, venue.address) : el('span'), list('Upcoming', events.map(eventRow)));
        }
        case 'event': {
          const event = await api.event(route.id);
          document.title = `${event.name} · Hot Mess`;
          return show(image(eventPhoto(event), event.name), el('h1', {}, event.name), el('p', { className: 'muted' }, when(event.start_at)), list('Where', event.venue ? [venueRow(event.venue)] : []));
        }
        case 'person': {
          const person = await api.person(route.id);
          document.title = `${person.name} · Hot Mess`;
          return show(image(person.photo_url, person.name), el('h1', {}, person.name));
        }
      }
    } catch (e) {
      if (e instanceof APIError && e.status === 401) return signIn();
      if (e instanceof APIError && e.status === 404) return message("We couldn't find that.");
      message("Hot Mess couldn't reach its server. Try again in a moment.");
    }
  }

  addEventListener('popstate', render);
  render();
</script>

<style is:global>
  .app { padding-top: 2rem; min-height: 50vh; }
  .app > img { width: 100%; max-height: 320px; object-fit: cover; border-radius: var(--radius); }
  .app h1 { font-size: clamp(1.8rem, 5vw, 2.6rem); margin: 1.25rem 0 .5rem; }
  .signin { max-width: 420px; margin: 2rem auto; padding: 1.5rem; }
  .signin h1 { margin-top: 0; }
  .error { color: var(--danger); }
  .rows { list-style: none; padding: 0; margin: 0; display: grid; gap: .5rem; }
  .rows a { display: flex; align-items: center; gap: .9rem; padding: .5rem; border-radius: var(--radius); color: var(--ink); text-decoration: none; background: var(--surface-raised); border: 1px solid var(--border); }
  .rows a:hover { border-color: var(--accent); }
  .rows img, .rows .placeholder { width: 56px; height: 56px; border-radius: 10px; object-fit: cover; flex: none; background: var(--surface-sunken); }
  .rows span { display: grid; min-width: 0; }
  .rows small { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
</style>
