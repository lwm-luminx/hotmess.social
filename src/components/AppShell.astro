---
// Public basics render on the server; authenticated details load only after hydration.
import App from '../app/App';
import '../app/help.css';
import type { PublicListing } from '../lib/publicListing';
interface Props { initialPath?: string; publicListing?: PublicListing; expired?: boolean }
const { initialPath = Astro.url.pathname + Astro.url.search, publicListing, expired } = Astro.props;
---
<main class="wrap app" id="app" aria-live="polite">
  <App initialPath={initialPath} publicListing={publicListing} expired={expired} client:load />
</main>

<style is:global>
  .app { padding-top: 1.5rem; min-height: 50vh; }
  .app-account { display: flex; justify-content: flex-end; margin-bottom: 1rem; }
  .poster-link { margin: 1.5rem 0 0; }
  /* The sign-in card's styles are in src/app/signin.css, shared with signed-in pages. */

  /* A shared post (src/app/PostView.tsx). */
  .post { display: grid; gap: 0.75rem; }
  .post-byline { display: flex; gap: 0.75rem; align-items: flex-start; }
  .post-byline p { margin: 0.1rem 0 0; }
  .post-face { width: 40px; height: 40px; border-radius: 10px; object-fit: cover; flex: none; }
  .post-poster { margin: 0; font-size: 1.15rem; }
  .post-poster a { color: inherit; }
  .post-body { margin: 0; white-space: pre-wrap; overflow-wrap: anywhere; }
  .post-photos { display: grid; gap: 2px; grid-template-columns: repeat(2, 1fr); border-radius: var(--radius); overflow: hidden; }
  .post-photos.count-1 { grid-template-columns: 1fr; }
  .post-photos img { width: 100%; height: 100%; aspect-ratio: 1; object-fit: cover; display: block; }
  .post-photos.count-1 img { aspect-ratio: 4 / 3; }
  .post-photos.count-3 img:first-child { grid-column: span 2; aspect-ratio: 2; }
  .post-footer { margin: 0; }
  .app-account { gap: 0.75rem; flex-wrap: wrap; }
  .small { font-size: 0.875rem; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

</style>
