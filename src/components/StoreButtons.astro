---
// The App Store and Google Play links, drawn in the site's own riso style (ink buttons with a pink or blue offset,
// like the download poster) rather than the stores' stock badges.
import { APP_STORE_URL, PLAY_STORE_URL } from '../lib/download';
---
<div class="stores">
  <a class="store ios" href={APP_STORE_URL}>
    <svg class="glyph" viewBox="14.5 8.5 15 22" aria-hidden="true"><path fill="currentColor" d="M24.76888,20.30068a4.94881,4.94881,0,0,1,2.35656-4.15206,5.06566,5.06566,0,0,0-3.99116-2.15768c-1.67924-.17626-3.30719,1.00483-4.1629,1.00483-.87227,0-2.18977-.98733-3.6085-.95814a5.31529,5.31529,0,0,0-4.47292,2.72787c-1.934,3.34842-.49141,8.26947,1.3612,10.97608.9269,1.32535,2.01018,2.8058,3.42763,2.7533,1.38706-.05753,1.9051-.88448,3.5794-.88448,1.65876,0,2.14479.88448,3.591.8511,1.48838-.02416,2.42613-1.33124,3.32051-2.66914a10.962,10.962,0,0,0,1.51842-3.09251A4.78205,4.78205,0,0,1,24.76888,20.30068Z"/><path fill="currentColor" d="M22.03725,12.21089a4.87248,4.87248,0,0,0,1.11452-3.49062,4.95746,4.95746,0,0,0-3.20758,1.65961,4.63634,4.63634,0,0,0-1.14371,3.36139A4.09905,4.09905,0,0,0,22.03725,12.21089Z"/></svg>
    <span><small>Download on the</small>App Store</span>
  </a>
  <a class="store android" href={PLAY_STORE_URL}>
    <svg class="glyph" viewBox="0 0 24 26" aria-hidden="true"><path fill="currentColor" d="M2.2.6C1.6.9 1.2 1.6 1.2 2.5v21c0 .9.4 1.6 1 1.9L14 13 2.2.6zm13.2 11L4.3.3l12.6 7.2-1.5 4.1zm0 2.8 1.5 4.1L4.3 25.7l11.1-11.3zm2.7-6.1 3.6 2.1c1.3.8 1.3 2.5 0 3.2l-3.6 2.1-1.7-3.7 1.7-3.7z"/></svg>
    <span><small>Get it on</small>Google Play</span>
  </a>
</div>

<style>
  .stores { display: flex; flex-wrap: wrap; gap: 1rem 1.25rem; }
  .store {
    --offset: #ff3d9a;
    display: inline-flex; align-items: center; gap: .7rem; min-width: 12.5rem; padding: .7rem 1.4rem .7rem 1.1rem;
    border-radius: 14px; background: #1a1519; color: #fff; text-decoration: none; border: 2px solid #1a1519;
    box-shadow: 5px 5px 0 var(--offset); transition: transform .12s ease, box-shadow .12s ease;
  }
  .store.android { --offset: #1e8cff; }
  .store:hover { transform: translate(-2px, -2px); box-shadow: 7px 7px 0 var(--offset); }
  .store:active { transform: translate(3px, 3px); box-shadow: 2px 2px 0 var(--offset); }
  .glyph { width: 1.7rem; height: 1.7rem; flex: none; }
  .store span { display: flex; flex-direction: column; font-weight: 800; font-size: 1.3rem; line-height: 1.1; letter-spacing: -.01em; }
  .store small { font-weight: 600; font-size: .72rem; letter-spacing: .02em; opacity: .85; }
  @media (prefers-color-scheme: dark) { .store { border-color: #f1eaea; } }
</style>
