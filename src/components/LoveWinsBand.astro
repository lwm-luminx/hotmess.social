---
// The slim band above the header on every page (via src/layouts/Base.astro)
// saying Hot Mess is a Love Wins Media product.
import { LOVE_WINS_URL } from '../lib/config';
---
<div class="lovewins-band">
  <a href={LOVE_WINS_URL} target="_blank" rel="noopener">
    <svg aria-hidden="true" viewBox="0 0 24 24" width="12" height="12"><path fill="currentColor" d="M12 21s-7.5-4.6-9.6-9.2C.9 8.4 3 4.5 6.7 4.5c2.1 0 3.5 1.1 4.3 2.4h2c.8-1.3 2.2-2.4 4.3-2.4 3.7 0 5.8 3.9 4.3 7.3C19.5 16.4 12 21 12 21z"/></svg>
    A Love Wins Media product
  </a>
</div>

<style>
  .lovewins-band {
    background: linear-gradient(90deg, #ec4899, #f59e0b);
    text-align: center;
    font-size: .8rem;
    font-weight: 700;
    letter-spacing: .02em;
    line-height: 1.2;
    padding: .35rem var(--gutter);
  }
  /* #3b0a1e on the pink-to-amber gradient stays above 4.5:1 end to end, in both themes. */
  .lovewins-band a { color: #3b0a1e; text-decoration: none; display: inline-flex; align-items: center; gap: .35em; }
  .lovewins-band a:hover { text-decoration: underline; }
  .lovewins-band a:focus-visible { outline: 2px solid #3b0a1e; outline-offset: 2px; border-radius: 2px; }
</style>
