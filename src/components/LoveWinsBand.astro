---
// The slim band above the header on every page (via src/layouts/Base.astro)
// saying Hot Mess is a Love Wins Media product. Matches audiencekit.com's band:
// "Love Wins Media" is the link, in pink-to-amber gradient text.
import { LOVE_WINS_URL } from '../lib/config';
---
<div class="lovewins-band">
  <svg aria-hidden="true" viewBox="0 0 24 24" width="13" height="13"><path d="M12 21s-7.5-4.6-9.6-9.2C.9 8.4 3 4.5 6.7 4.5c2.1 0 3.5 1.1 4.3 2.4h2c.8-1.3 2.2-2.4 4.3-2.4 3.7 0 5.8 3.9 4.3 7.3C19.5 16.4 12 21 12 21z"/></svg>
  <span>A <a href={LOVE_WINS_URL} target="_blank" rel="noopener">Love Wins Media</a> product</span>
</div>

<style>
  .lovewins-band {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 7px;
    background: linear-gradient(90deg, #ec489926, #f59e0b1f);
    border-bottom: 1px solid var(--border);
    color: var(--ink);
    font-size: .75rem;
    line-height: 1.4;
    letter-spacing: .02em;
    padding: 7px var(--gutter);
  }
  .lovewins-band::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: linear-gradient(90deg, #ec4899, #f59e0b);
  }
  .lovewins-band svg { flex: none; fill: #ec4899; }
  /* Darker stops on the light theme keep the gradient text readable on a near-white band. */
  .lovewins-band a {
    font-weight: 700;
    text-decoration: none;
    background: linear-gradient(90deg, #db2777, #d97706);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .lovewins-band a:hover { text-decoration: underline; text-decoration-color: #d97706; }
  .lovewins-band a:focus-visible { outline: 2px solid #ec4899; outline-offset: 2px; border-radius: 2px; }
  @media (prefers-color-scheme: dark) {
    .lovewins-band a { background-image: linear-gradient(90deg, #f472b6, #fbbf24); }
    .lovewins-band a:hover { text-decoration-color: #fbbf24; }
  }
</style>
