---
import Base from '../layouts/Base.astro';
import StoreButtons from '../components/StoreButtons.astro';

// Hot Mess is ad-free (Rick, 2026-11-14): no outside ads, only sponsorships, meaning a sponsor pays to place existing
// Hot Mess content (a venue's own listing or event). Keep this page in step with what the apps actually show.
const youSee = [
  {
    title: 'Sponsored listings',
    body: 'A venue or promoter can sponsor its own Hot Mess listing or event, so it also shows in a spot between listings. It’s the same listing you’d find anyway, labelled “Sponsored”, never the first thing you see and never an outside ad.',
  },
  {
    title: 'Hot Mess announcements',
    body: 'News about Hot Mess itself, like a new feature or a change to the rules. Labelled “Announcement”.',
  },
  {
    title: 'Free cards for queer charities',
    body: 'Community groups and charities we choose to feature, free of charge. Labelled “Charity”.',
  },
  {
    title: 'Our own apps for the people who make the night',
    body: 'Cards about AudienceKit, the platform Hot Mess runs on, and its apps for the people who keep listings up to date: Velvet for venue staff and Backstage for performers and promoters. Labelled “From AudienceKit”. An app’s card hides once you have the app.',
  },
];

const neverDo = [
  'Run outside ads, banners or brand campaigns in Hot Mess.',
  'Sell or share your data with advertisers or data brokers.',
  'Let anyone target you by who you are, what you look like or who you’re into.',
  'Put tracking pixels or ad networks in Hot Mess.',
  'Charge you to use Hot Mess.',
];
---
<Base title="How Hot Mess is paid for" description="Hot Mess is free and ad-free. The only paid spots are sponsored Hot Mess listings, labelled and never targeted at you.">
  <main>
    <section class="hero">
      <div class="wrap">
        <p class="eyebrow">How Hot Mess is paid for</p>
        <h1>No ads. Just the night.</h1>
        <p class="lede">Hot Mess is free and ad-free: no outside ads, banners or brand campaigns. The only thing anyone can pay for is a sponsored spot for their own Hot Mess listing, clearly labelled, and it never pushes anyone else off the list.</p>
      </div>
    </section>

    <section class="wrap" aria-labelledby="see">
      <h2 id="see">What you might see between listings</h2>
      <div class="grid">
        {youSee.map((r) => (
          <article class="card item">
            <h3>{r.title}</h3>
            <p class="muted">{r.body}</p>
          </article>
        ))}
      </div>
      <p class="muted">None of these are chosen using anything about you: not your profile, your tribes or where you have been.</p>
    </section>

    <section class="wrap split" aria-labelledby="never">
      <div>
        <h2 id="never">What we never do</h2>
        <ul>{neverDo.map((l) => <li>{l}</li>)}</ul>
      </div>
      <div>
        <h2 id="different">Why it works this way</h2>
        <p>A lot of free apps are paid for by learning about the people who use them and selling chances to reach them. For a community where being found by the wrong person can mean harassment or being outed, that's the wrong trade.</p>
      </div>
    </section>

    <section class="wrap" aria-labelledby="where">
      <article class="card where">
        <h2 id="where">Who pays for it</h2>
        <p>Hot Mess is run by <a href="https://lovewins.media">Love Wins Media</a>, which builds <a href="https://audiencekit.com">AudienceKit</a>, the platform Hot Mess runs on. Sponsored listings help, and Love Wins Media covers the rest of the hosting, moderation and development.</p>
      </article>
    </section>

    <section class="wrap get">
      <h2>Get Hot Mess</h2>
      <p class="muted">See also <a href="/safety">Safety</a>, our <a href="https://audiencekit.com/privacy/">Privacy Policy</a> and <a href="https://audiencekit.com/terms/">Terms</a>.</p>
      <StoreButtons />
    </section>
  </main>
</Base>

<style>
  .hero { padding: clamp(3rem, 9vw, 6rem) 0 clamp(1.5rem, 4vw, 3rem); background: radial-gradient(120% 90% at 10% 0%, var(--accent-soft), transparent 60%); }
  .eyebrow { color: var(--accent); font-weight: 700; text-transform: uppercase; letter-spacing: .08em; font-size: .85rem; margin: 0 0 .75rem; }
  h1 { font-size: clamp(2.2rem, 6.5vw, 4rem); font-weight: 800; margin: 0 0 1rem; max-width: 16ch; }
  .lede { font-size: clamp(1.05rem, 2.2vw, 1.3rem); color: var(--ink-muted); max-width: 52ch; margin: 0; }
  h2 { font-size: 1.6rem; margin: 3rem 0 1rem; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; }
  .why-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 0 2rem; }
  .why-grid p { margin: 0 0 1rem; max-width: 60ch; }
  .item { padding: 1.25rem 1.25rem .5rem; }
  .item h3 { margin: 0 0 .5rem; font-size: 1.15rem; }
  .split { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 0 2rem; }
  ul { margin: 0; padding-left: 1.2rem; }
  li { margin: .5rem 0; }
  .table-wrap { overflow-x: auto; margin: 1rem 0; }
  table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
  th, td { text-align: left; padding: .75rem .5rem; border-bottom: 1px solid var(--border); vertical-align: top; }
  td { font-weight: 700; white-space: nowrap; }
  tbody th span { display: block; font-weight: 400; font-size: .9rem; }
  .discounts { margin: 0 0 1rem; }
  .where { margin-top: 3rem; padding: 1.5rem; background: linear-gradient(135deg, var(--accent-soft), var(--surface-raised) 70%); }
  .where h2 { margin: 0 0 .75rem; font-size: 1.4rem; }
  .where p { margin: 0; }
  .get h2 { margin-bottom: .5rem; }
  .get p { margin: 0 0 1.25rem; }
</style>
