---
import Base from '../layouts/Base.astro';
import { HeroBanner, SectionHeading } from '@lwm-luminx/astro-components';
import StoreButtons from '../components/StoreButtons.astro';
import PosterCallout from '../components/PosterCallout.astro';

const features = [
  { title: 'Now', body: 'Open the app and see what is happening near you right now: the bar you are in, who is spinning, and where the night is heading.' },
  { title: 'Events', body: 'Every party, drag show and DJ set in your city on one calendar, with RSVPs your friends can see.' },
  { title: 'Venues', body: 'The bars and clubs that make up your scene, with their upcoming nights and the friends who are there.' },
  { title: 'People', body: 'Follow the DJs, hosts and performers you love, hear their latest sets and never miss their next gig.' },
];
---
<Base>
  <main>
    <HeroBanner
      id="home-title"
      heading="Where your people are tonight."
      eyebrow="Queer nightlife, live"
      description="Hot Mess shows you the venues, events and DJs of your scene, and which of your friends are already out."
    >
      <StoreButtons />
      <p class="web">No phone handy? <a href="/app/">Peek on the web</a>.</p>
      <div slot="media" class="phones" aria-hidden="true">
        <img class="phone back" src="/screens/venue-chat.webp" alt="" width="600" height="1304" />
        <img class="phone front" src="/screens/venue-tonight.webp" alt="" width="600" height="1304" />
      </div>
    </HeroBanner>

    <section class="wrap features" aria-label="What Hot Mess does">
      {features.map((f) => (
        <article class="card feature">
          <h2>{f.title}</h2>
          <p class="muted">{f.body}</p>
        </article>
      ))}
    </section>

    <section class="wrap safety" aria-labelledby="safety">
      <article class="card safety-card">
        <SectionHeading id="safety" eyebrow="Safety, built in" title="You choose who sees you." />
        <ul>
          <li><strong>Members only.</strong> Everything sits behind a free 18+ account, so bans and blocks stick. People who aren't your friends see your first name and last initial.</li>
          <li><strong>Report or block anyone.</strong> Blocking works both ways, and moderators act on reports within 24 hours.</li>
          <li><strong>Chat stays in the room.</strong> A venue's chat opens only for the people who are there.</li>
          <li><strong>Bans stick.</strong> Someone banned from a venue can't see it, its events or its chat.</li>
        </ul>
        <a class="go" href="/safety">How Hot Mess keeps you safe →</a>
      </article>
    </section>

    <section id="get-the-app" class="wrap get" aria-labelledby="get-title">
      <SectionHeading id="get-title" title="Take it out with you" />
      <article class="card get-card">
        <div>
          <p class="eyebrow">iPhone and Android</p>
          <h3>Hot Mess is on the App Store and Google Play</h3>
          <p class="muted">Get it on your phone, or scan the code with your camera and it opens the right store.</p>
          <StoreButtons />
        </div>
        <a class="qr" href="/download"><img src="/download-qr.svg" alt="QR code for hotmess.social/download" width="160" height="160" /></a>
      </article>
    </section>

    <section class="wrap">
      <PosterCallout />
    </section>
  </main>
</Base>

<style>
  .eyebrow { color: var(--accent); font-weight: 700; text-transform: uppercase; letter-spacing: .08em; font-size: .85rem; margin: 0 0 .75rem; }
  .phones { position: relative; height: 34rem; }
  .phone { position: absolute; width: 14.5rem; height: auto; border-radius: 2.2rem; border: 6px solid #1a1519; background: #000; }
  .phone.back { right: 0; top: 0; transform: rotate(7deg); box-shadow: 10px 10px 0 #1e8cff; }
  .phone.front { left: 0; top: 2.5rem; transform: rotate(-5deg); box-shadow: 10px 10px 0 #ff3d9a; }
  @media (prefers-color-scheme: dark) { .phone { border-color: #3a3234; } }
  @media (max-width: 1100px) {
    .phones { height: 29rem; }
    .phone { width: 12rem; }
    .phone.back { right: 1.25rem; }
  }
  @media (max-width: 900px) {
    .phones { display: none; }
  }
  .web a { color: var(--lwm-hero-accent, #ff9fca); }
  .web { color: var(--lwm-hero-muted, #e0d2df); margin: 1.5rem 0 0; font-size: .95rem; }
  .features { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin-top: 2rem; }
  .feature { padding: 1.25rem 1.25rem .5rem; }
  .feature h2 { margin: 0 0 .5rem; font-size: 1.3rem; }
  .safety { margin-top: 3rem; }
  .safety-card { padding: 1.5rem; }
  .safety-card ul { margin: 0 0 1.25rem; padding-left: 1.2rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); gap: .5rem 2rem; }
  .safety-card .go { font-weight: 700; }
  .get { margin-top: 4rem; }
  .get-card { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem 2rem; padding: 1.5rem; background: linear-gradient(135deg, var(--accent-soft), var(--surface-raised) 70%); }
  .get-card > div { flex: 1 1 32ch; }
  .get-card .eyebrow { margin-bottom: .4rem; }
  .get-card h3 { margin: 0 0 .5rem; font-size: 1.4rem; }
  .get-card p { margin: 0 0 1.25rem; }
  .get-card .qr { line-height: 0; }
  @media (max-width: 600px) { .get-card .qr { display: none; } } /* nobody scans their own screen */
  .get-card .qr img { width: 160px; height: 160px; padding: 8px; background: #fff; border-radius: 12px; }
</style>
