---
import Base from '../layouts/Base.astro';
import PosterStudio from '../components/poster/PosterBuilder';
---
<Base title="Make a poster" description="Make a Hot Mess poster: sign in, pick a line, a size and a look, add a QR code for the app or your venue or night, and download a print-ready PDF.">
  <main class="wrap poster">
    <header class="intro">
      <p class="eyebrow">Print it. Post it.</p>
      <h1>Put Hot Mess up where your people are.</h1>
      <p class="lede">Hot Mess grows one bar, one dance floor and one bathroom mirror at a time. Pick a line, a size and a look, and download a poster for your board, your feed or the TV over the bar.</p>
    </header>

    <PosterStudio client:only="react" />

    <section class="where">
      <div>
        <h2>Where it belongs</h2>
        <ul>
          <li>Gay bars and clubs: the entrance, the coat check, the bathroom</li>
          <li>LGBTQ+ community centers and resource boards</li>
          <li>Queer bookstores, coffee shops and gyms</li>
          <li>Drag brunches, Pride events and your own party</li>
        </ul>
        <p class="muted">Ask the venue before you put it up, and use tape that comes off clean. The download QR code covers everyone: iPhones land on the App Store and Android phones on Google Play.</p>
      </div>
      <div>
        <h2>The classic poster</h2>
        <p class="muted">Our original one-QR poster is here for anyone, no sign-in needed. US Letter, fine on A4 with "fit to page".</p>
        <div class="actions">
          <a class="button secondary" href="/poster/hot-mess-poster.pdf" download>Download the PDF</a>
          <a class="button secondary" href="/poster/hot-mess-poster.png" download>PNG image</a>
        </div>
      </div>
    </section>
  </main>
</Base>

<style is:global>
  @font-face { font-family: "Big Shoulders Display"; src: url("/fonts/poster/big-shoulders-display-latin-700-normal.woff2") format("woff2"); font-weight: 700; font-display: swap; }
  @font-face { font-family: "Big Shoulders Display"; src: url("/fonts/poster/big-shoulders-display-latin-900-normal.woff2") format("woff2"); font-weight: 900; font-display: swap; }
  @font-face { font-family: "Caveat Brush"; src: url("/fonts/poster/caveat-brush-latin-400-normal.woff2") format("woff2"); font-weight: 400; font-display: swap; }
  @font-face { font-family: "Archivo"; src: url("/fonts/poster/archivo-latin-400-normal.woff2") format("woff2"); font-weight: 400; font-display: swap; }
  @font-face { font-family: "Archivo"; src: url("/fonts/poster/archivo-latin-600-normal.woff2") format("woff2"); font-weight: 600; font-display: swap; }
  @font-face { font-family: "Archivo"; src: url("/fonts/poster/archivo-latin-800-normal.woff2") format("woff2"); font-weight: 800; font-display: swap; }

  .poster-builder { --night: #120d16; --night-raised: #1c1521; --night-line: #3a2c42; --night-ink: #f7eef8; --night-dim: #b9a6c2; --hot: #ff3d9a; }
  .poster-builder h2 { font-size: 1.4rem; margin: 0 0 1rem; }

  .poster-builder .presets { margin: 2.5rem 0 3rem; }
  .poster-builder .presets ul { list-style: none; margin: 0; padding: 0 0 .5rem; display: grid; grid-auto-flow: column; grid-auto-columns: minmax(150px, 1fr); gap: 1rem; overflow-x: auto; align-items: end; }
  .poster-builder .presets button { all: unset; display: grid; gap: .5rem; cursor: pointer; width: 100%; }
  .poster-builder .presets button:focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; border-radius: 4px; }
  .poster-builder .presets canvas { display: block; width: 100%; height: auto; border-radius: 4px; box-shadow: var(--shadow-md); transition: transform .2s ease; }
  .poster-builder .presets button:hover canvas { transform: rotate(-1deg) translateY(-2px); }
  .poster-builder .presets span { display: grid; font-size: .85rem; color: var(--ink-muted); }
  .poster-builder .presets b { color: var(--ink); font-weight: 600; }

  .poster-builder .builder { display: grid; grid-template-columns: minmax(0, 340px) minmax(0, 1fr); gap: 2rem; align-items: start; }
  .poster-builder .builder > h2 { grid-column: 1 / -1; margin: 0; }
  .poster-builder .controls { display: grid; gap: 1.25rem; }
  .poster-builder fieldset { border: 0; border-top: 1px solid var(--border); margin: 0; padding: 1rem 0 0; display: grid; gap: .6rem; min-width: 0; }
  .poster-builder legend { padding: 0; font-size: .8rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-muted); float: left; width: 100%; }
  .poster-builder legend + * { clear: both; }
  .poster-builder input[type=radio], .poster-builder input[type=checkbox] { accent-color: var(--accent); }
  .poster-builder select, .poster-builder .event input { width: 100%; min-height: 40px; padding: .45rem .6rem; border: 1px solid var(--border); border-radius: 8px; background: var(--surface-raised); color: var(--ink); font: inherit; }
  .poster-builder .check { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: .5rem; align-items: start; cursor: pointer; }
  .poster-builder .check input { margin-top: .3rem; }
  .poster-builder .check small { display: block; color: var(--ink-muted); }
  .poster-builder .slogans { max-height: 340px; overflow-y: auto; border: 1px solid var(--border); border-radius: 10px; padding: .25rem .5rem .5rem; background: var(--surface-raised); }
  .poster-builder .slogans h3 { font-size: .75rem; letter-spacing: .08em; text-transform: uppercase; color: var(--accent); margin: .75rem .4rem .25rem; }
  .poster-builder .opt { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: .5rem; padding: .4rem; border-radius: 6px; cursor: pointer; font-size: .95rem; line-height: 1.35; }
  .poster-builder .opt input { margin-top: .2rem; }
  .poster-builder .opt:hover, .poster-builder .opt.on { background: var(--accent-soft); }
  .poster-builder .tag { font-style: normal; font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; margin-left: .4rem; color: var(--accent); }
  .poster-builder .seg { display: grid; grid-template-columns: 1fr 1fr; gap: .4rem; }
  .poster-builder .seg label { position: relative; display: grid; padding: .5rem .65rem; border: 1px solid var(--border); border-radius: 8px; cursor: pointer; font-size: .9rem; }
  .poster-builder .seg small { color: var(--ink-muted); font-size: .78rem; }
  .poster-builder .seg input, .poster-builder .looks input { position: absolute; opacity: 0; pointer-events: none; }
  .poster-builder .seg label:has(input:checked) { border-color: var(--accent); box-shadow: inset 0 0 0 1px var(--accent); }
  .poster-builder .seg label:has(input:focus-visible), .poster-builder .looks label:has(input:focus-visible) .chip { outline: 3px solid var(--focus); outline-offset: 2px; }
  .poster-builder .looks { display: grid; grid-template-columns: repeat(4, 1fr); gap: .5rem; }
  .poster-builder .looks label { position: relative; display: grid; gap: .35rem; justify-items: center; font-size: .82rem; color: var(--ink-muted); cursor: pointer; }
  .poster-builder .looks label:has(input:checked) { color: var(--ink); font-weight: 600; }
  .poster-builder .chip { width: 100%; aspect-ratio: 1; border-radius: 8px; border: 2px solid transparent; }
  .poster-builder .looks label:has(input:checked) .chip { border-color: var(--ink); }
  .poster-builder .chip.neon { background: radial-gradient(circle at 70% 25%, #ff2e9a 0 18%, transparent 19%), radial-gradient(circle at 30% 70%, #27e6ff 0 14%, transparent 15%), #0c0814; }
  .poster-builder .chip.glitter { background: radial-gradient(#ffe08a 1px, transparent 1.5px) 0 0/7px 7px, linear-gradient(160deg, #3a0c3f, #1a0b2e); }
  .poster-builder .chip.riso { background: linear-gradient(120deg, transparent 0 40%, rgba(31,60,255,.85) 40% 62%, transparent 62%), radial-gradient(circle at 35% 40%, #ff3d7f 0 30%, transparent 31%), #f2ead8; }
  .poster-builder .chip.sticker { background: linear-gradient(-8deg, transparent 0 30%, #ffe600 30% 48%, transparent 48% 56%, #ff4fa3 56% 72%, transparent 72%), #141114; }
  .poster-builder .qr-modes { display: grid; gap: .3rem; }
  .poster-builder .qr-modes label { display: flex; gap: .5rem; align-items: center; cursor: pointer; }
  .poster-builder .event { display: grid; gap: .5rem; }
  .poster-builder .event label { display: grid; gap: .2rem; font-size: .82rem; color: var(--ink-muted); }
  .poster-builder .hint { font-size: .82rem; color: var(--ink-muted); margin: 0; }
  .poster-builder .listing-search { display: grid; gap: .35rem; }
  .poster-builder .listing-search > label { font-size: .82rem; color: var(--ink-muted); }
  .poster-builder .listing-search input { width: 100%; min-height: 40px; padding: .45rem .6rem; border: 1px solid var(--border); border-radius: 8px; background: var(--surface-raised); color: var(--ink); font: inherit; }
  .poster-builder .results h3 { font-size: .72rem; letter-spacing: .08em; text-transform: uppercase; color: var(--accent); margin: .6rem 0 .25rem; }
  .poster-builder .results ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .25rem; }
  .poster-builder .results button { all: unset; box-sizing: border-box; display: grid; width: 100%; padding: .45rem .6rem; border-radius: 6px; cursor: pointer; }
  .poster-builder .results button:hover { background: var(--accent-soft); }
  .poster-builder .results button:focus-visible { outline: 3px solid var(--focus); outline-offset: 1px; }
  .poster-builder .results small, .poster-builder .picked small { display: block; color: var(--ink-muted); font-size: .8rem; }
  .poster-builder .picked { display: flex; gap: .75rem; align-items: center; justify-content: space-between; padding: .6rem .75rem; border: 1px solid var(--accent); border-radius: 8px; }
  .poster-builder .picked p { margin: 0; min-width: 0; overflow-wrap: anywhere; }

  .poster-builder .stage { display: grid; gap: .75rem; min-width: 0; position: sticky; top: 1rem; }
  .poster-builder .frame { display: flex; justify-content: center; align-items: center; padding: clamp(.75rem, 3vw, 1.75rem); min-height: 280px; border-radius: var(--radius); background: repeating-linear-gradient(45deg, var(--night) 0 12px, var(--night-raised) 12px 24px); }
  .poster-builder .frame canvas { display: block; max-width: 100%; max-height: 72vh; width: auto; height: auto; box-shadow: 0 18px 40px rgba(0,0,0,.55); }
  .poster-builder .bar { display: flex; flex-wrap: wrap; gap: .75rem; align-items: center; justify-content: space-between; }
  .poster-builder .meta { margin: 0; font-size: .88rem; color: var(--ink-muted); font-variant-numeric: tabular-nums; }
  .poster-builder .actions { display: flex; flex-wrap: wrap; gap: .5rem; }
  .poster-builder .button:disabled { opacity: .6; cursor: progress; }
  .poster-builder .status { margin: 0; min-height: 1.5em; font-size: .88rem; color: var(--ink-muted); }

  @media (max-width: 820px) {
    .poster-builder .builder { grid-template-columns: minmax(0, 1fr); }
    .poster-builder .stage { position: static; order: -1; }
    .poster-builder .builder > h2 { order: -2; }
  }
  @media (prefers-reduced-motion: reduce) { .poster-builder .presets canvas { transition: none; } }
</style>

<style>
  .poster { padding: clamp(2.5rem, 7vw, 4.5rem) 0 2rem; }
  .intro { max-width: 46rem; }
  .eyebrow { color: var(--accent); font-weight: 700; text-transform: uppercase; letter-spacing: .08em; font-size: .85rem; margin: 0 0 .75rem; }
  h1 { font-size: clamp(2rem, 5.5vw, 3.3rem); font-weight: 800; margin: 0 0 1rem; }
  .lede { font-size: 1.15rem; color: var(--ink-muted); margin: 0; }
  .where { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr); gap: clamp(1.5rem, 5vw, 3.5rem); margin-top: 3.5rem; border-top: 1px solid var(--border); padding-top: 2rem; }
  .where h2 { font-size: 1.4rem; margin: 0 0 .75rem; }
  .where ul { margin: 0 0 1rem; padding-left: 1.2rem; }
  .where li { margin: .35rem 0; }
  .actions { display: flex; flex-wrap: wrap; gap: .75rem; }
  @media (max-width: 760px) { .where { grid-template-columns: 1fr; } }
</style>
