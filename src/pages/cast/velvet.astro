---
// The Velvet cast receiver: a Chromecast (or a TV with Cast built in) that Velvet's Tonight tab picks shows tonight
// at the venue, like Velvet's AirPlay marquee on iOS. The phone sends the board ready to show over the
// urn:x-cast:com.audiencekit.velvet channel: the lineup, and the room's live chat when the sign-in may moderate it.
// It lays the board out as the marquee does: the join QR code top left beside the venue, the chat in the right third,
// drawn as guests see the room. With `slogans: { adult, hidden, slides }` in the message (the venue's TV slogans on:
// its audience's posters, less the ids it turned off; this site's own set when a sender gives no `slides`), slides
// rotate in between, full screen, taking turns with the upcoming events' posters in `posters`.
// `mode` picks what this TV shows when one sender drives several (Velvet Display on a Mac): "board" (the default, all
// of it), "lineup" (no chat), "chat" (the chat wall, the whole screen) or "posters" (the upcoming events' posters back to
// back), "photos" (the photo wall: the venue's trusted photographers' recent photos, one large and up to four beside
// it, turning over), or "lyrics" (the sing-along lyrics in time with the song, full screen). A mode it can't fill (no
// chat, no posters, no photos, no lyrics) shows the board.
// For "photos" Velvet Display sends `photos` ([{ id, url, caption?, credit, alt?, width?, height? }], newest first,
// https previews only; the sender has already left out hidden and old ones).
// `social` ([{ provider, handle, url }], the venue's social media profiles) puts a "follow us" slide with a code to each
// in the poster loop, once after every round of posters (src/lib/poster/social.ts, rotation.ts).
// Velvet Display also sends `nowPlaying` ({ title, artist, artwork }, the song in the room, along the bottom of the
// board), `comingUp` ([{ name, when }], the next nights' events, shown when tonight has no lineup) and, for "lyrics",
// `lyrics` ({ title, artist, lines: [{ t, text }], position, playing }): the lines with their times in seconds and where
// the song was when sent. A `{ type: "clock", position, playing }` message moves the song's clock between boards.
// Nothing here signs in or reads the API, so the page shows nothing until a phone sends it something. When the last
// phone leaves, the TV keeps going on the web sign's board (/venues/<id>/display): the public lineup, no chat.
// Registered as a Custom Receiver in the Google Cast SDK Developer Console; the apps carry its application ID.
// Velvet on Samsung TVs frames it as /cast/velvet/?screen=tizen and sends the same messages with postMessage (Cast
// isn't started there).
import '../../styles/global.css';
import '../../styles/venue-board.css';
export const prerender = true;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Velvet · Tonight</title>
    <script is:inline src="https://www.gstatic.com/cast/sdk/libs/caf_receiver/v3/cast_receiver_framework.js"></script>
  </head>
  <body>
    <div class="screen">
      <main id="board"><p class="idle">Pick this TV in Velvet’s Tonight tab.</p></main>
      <section id="lyrics" hidden>
        <p class="song"></p>
        <ol class="lines"></ol>
      </section>
      <section id="photos" hidden>
        <div class="wall"></div>
        <footer><strong class="venue-name"></strong><span class="credit"></span></footer>
      </section>
      <aside id="chat" hidden>
        <p class="chat-head"><span class="kicker">Chat</span><span class="room"></span></p>
        <p id="pinned" hidden></p>
        <ol id="messages"></ol>
      </aside>
    </div>
    <script is:inline>
      (function () {
        var NS = 'urn:x-cast:com.audiencekit.velvet';
        var board = document.getElementById('board');
        var chat = document.getElementById('chat');
        var zone = 'America/Los_Angeles';
        var venueId = null;
        var fallbackTimer = null;

        // A picture too small to fill the TV without being blown up more than half again (a venue's old profile
      // photo) looks soft behind the board: it's skipped, as on the Apple TV and Mac (Rick, 2026-11-21).
      var backdropChecks = {};
      function sharpBackdrop(target, url, dim) {
        var apply = function (sharp) {
          if (!sharp) return;
          var shade = 'rgba(0,0,0,' + (dim || .45) + ')';
          target.style.backgroundImage = 'linear-gradient(' + shade + ', ' + shade + '), url("' +
            url.replace(/["\\]/g, '') + '")';
          target.classList.add('photo');
        };
        if (url in backdropChecks) return apply(backdropChecks[url]);
        var probe = new Image();
        probe.onload = function () {
          var stretch = Math.max(1920 / Math.max(probe.naturalWidth, 1), 1080 / Math.max(probe.naturalHeight, 1));
          backdropChecks[url] = stretch <= 1.5;
          apply(backdropChecks[url]);
        };
        probe.onerror = function () { backdropChecks[url] = false; };
        probe.src = url;
      }

      function el(tag, className, text) {
          var node = document.createElement(tag);
          if (className) node.className = className;
          if (text != null) node.textContent = text;
          return node;
        }
        function image(url) {
          if (typeof url !== 'string' || url.indexOf('https://') !== 0) return null;
          var img = el('img');
          img.src = url; img.alt = ''; img.loading = 'lazy';
          return img;
        }
        // The lineup's symbols, drawn as Velvet's apps draw them (SF Symbols on Apple TV): outline strokes in the
        // text's colour.
        var SVG = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">';
        var GLYPHS = {
          headphones: SVG + '<path d="M4 15v-3a8 8 0 0 1 16 0v3"/><rect x="3" y="14" width="4" height="7" rx="1.5"/><rect x="17" y="14" width="4" height="7" rx="1.5"/></svg>',
          sparkles: SVG + '<path d="M10 3l1.6 4.4L16 9l-4.4 1.6L10 15l-1.6-4.4L4 9l4.4-1.6z"/><path d="M18 14l.8 2.2L21 17l-2.2.8L18 20l-.8-2.2L15 17l2.2-.8z"/></svg>',
          masks: SVG + '<path d="M3 5c3 1 6 1 9 0v6a4.5 4.5 0 0 1-9 0z"/><path d="M12 8c3 1 6 1 9 0v6a4.5 4.5 0 0 1-9 0"/><path d="M5.5 8.5h1M8.5 8.5h1M5.8 12.5c.8.7 2 .7 2.9 0M14.5 11.5h1M17.5 11.5h1M15 16c.9-.7 2.1-.7 3 0"/></svg>',
          mic: SVG + '<rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/></svg>',
          waveform: SVG + '<path d="M3 12h1M7 8v8M11 5v14M15 9v6M19 11v2M21 12h0"/></svg>',
          pin: SVG + '<path d="M9 3h6l-1 6 3 3v2H7v-2l3-3z"/><path d="M12 14v7"/></svg>',
        };
        function roleGlyph(role) {
          if (role === 'DJ') return GLYPHS.headphones;
          if (role === 'Host') return GLYPHS.sparkles;
          if (role === 'Performer') return GLYPHS.masks;
          if (role === 'MC' || role === 'Singer' || role.indexOf('Singing') === 0) return GLYPHS.mic;
          return null;
        }
        function clock() {
          try { return new Intl.DateTimeFormat('en-US', { hour: 'numeric', minute: '2-digit', timeZone: zone }).format(new Date()); }
          catch (e) { return ''; }
        }
        function tick() { var c = board.querySelector('[data-clock]'); if (c) c.textContent = clock(); }

        // The sing-along lyrics: the lines and the song's clock, which runs on here between messages.
        var lyricsBox = document.getElementById('lyrics');
        var song = null;
        var songClock = { position: 0, playing: false, at: Date.now() };
        var shownLine = null;
        function setClock(position, playing) {
          if (typeof position !== 'number') return;
          songClock = { position: position, playing: playing === true, at: Date.now() };
        }
        function songPosition() {
          return songClock.playing ? songClock.position + (Date.now() - songClock.at) / 1000 : songClock.position;
        }
        function showLyrics(data) {
          var lines = data && Array.isArray(data.lines) ? data.lines.filter(function (line) {
            return line && typeof line.t === 'number' && typeof line.text === 'string';
          }) : [];
          song = lines.length ? { title: data.title || '', artist: data.artist || '', lines: lines } : null;
          if (song) setClock(data.position, data.playing);
          shownLine = null;
          lyricsBox.querySelector('.song').textContent = song ? [song.title, song.artist].filter(Boolean).join(' · ') : '';
          drawLyrics();
        }
        // The line being sung, big, with the one before and the next two, as Velvet Display's own screens show it.
        function drawLyrics() {
          if (lyricsBox.hidden || !song) return;
          var now = songPosition();
          var index = -1;
          for (var i = 0; i < song.lines.length; i++) { if (song.lines[i].t <= now) index = i; else break; }
          if (index === shownLine) return;
          shownLine = index;
          var list = lyricsBox.querySelector('.lines');
          list.textContent = '';
          for (var j = index - 1; j <= index + 2; j++) {
            if (j < 0 || j >= song.lines.length) { list.appendChild(el('li', 'blank', ' ')); continue; }
            list.appendChild(el('li', j === index ? 'now' : j < index ? 'past' : 'next', song.lines[j].text || '♪'));
          }
        }
        setInterval(drawLyrics, 100);

        // The photo wall: the lead photo large, the next four beside it, the lead moving on every 12 seconds.
        var photosBox = document.getElementById('photos');
        var wallPhotos = [];
        var wallLead = 0;
        var wallTimer = null;
        function cleanPhotos(list) {
          var seen = {};
          return (Array.isArray(list) ? list : []).filter(function (photo) {
            if (!photo || typeof photo.url !== 'string' || photo.url.indexOf('https://') !== 0 || seen[photo.url]) return false;
            seen[photo.url] = true;
            return true;
          }).slice(0, 24);
        }
        function creditLine(photos) {
          var names = [], seen = {};
          photos.forEach(function (photo) {
            var name = typeof photo.credit === 'string' ? photo.credit.trim() : '';
            if (name && !seen[name.toLowerCase()]) { seen[name.toLowerCase()] = true; names.push(name); }
          });
          if (!names.length) return '';
          if (names.length === 1) return 'Photos by ' + names[0];
          if (names.length === 2) return 'Photos by ' + names[0] + ' and ' + names[1];
          if (names.length === 3) return 'Photos by ' + names[0] + ', ' + names[1] + ' and ' + names[2];
          return 'Photos by ' + names[0] + ', ' + names[1] + ' and ' + (names.length - 2) + ' more';
        }
        function photoTile(photo, large) {
          var tile = el('figure', large ? 'tile large' : 'tile');
          var img = image(photo.url);
          if (img) { img.loading = 'eager'; if (typeof photo.alt === 'string') img.alt = photo.alt; tile.appendChild(img); }
          var caption = el('figcaption');
          if (large && typeof photo.caption === 'string' && photo.caption) caption.appendChild(el('strong', null, photo.caption));
          if (typeof photo.credit === 'string' && photo.credit) caption.appendChild(el('span', null, photo.credit));
          tile.appendChild(caption);
          return tile;
        }
        function drawWall() {
          var wall = photosBox.querySelector('.wall');
          wall.textContent = '';
          if (!wallPhotos.length) return;
          var count = Math.min(5, wallPhotos.length);
          var shown = [];
          for (var i = 0; i < count; i++) shown.push(wallPhotos[(wallLead + i) % wallPhotos.length]);
          wall.classList.toggle('single', count === 1);
          wall.appendChild(photoTile(shown[0], true));
          if (count > 1) {
            var side = el('div', 'side');
            shown.slice(1).forEach(function (photo) { side.appendChild(photoTile(photo, false)); });
            side.classList.toggle('few', count < 4);
            wall.appendChild(side);
          }
          photosBox.querySelector('.credit').textContent = creditLine(shown);
        }
        function showPhotos(list, venueName) {
          var fresh = cleanPhotos(list);
          var same = fresh.length === wallPhotos.length && fresh.every(function (photo, i) { return photo.url === wallPhotos[i].url; });
          photosBox.querySelector('.venue-name').textContent = venueName || '';
          if (same && wallTimer) return;
          wallPhotos = fresh;
          wallLead = 0;
          drawWall();
          if (wallTimer) clearInterval(wallTimer);
          wallTimer = wallPhotos.length > 1 ? setInterval(function () {
            wallLead = (wallLead + 1) % wallPhotos.length;
            drawWall();
          }, 12000) : null;
        }
        function hidePhotos() {
          if (wallTimer) clearInterval(wallTimer);
          wallTimer = null;
          wallPhotos = [];
          photosBox.querySelector('.wall').textContent = '';
        }

        // The song in the room, along the bottom of the board.
        function nowPlaying(song) {
          if (!song || typeof song.title !== 'string' || !song.title) return null;
          var strip = el('div', 'now-playing');
          var art = image(song.artwork);
          if (art) strip.appendChild(art);
          var text = el('div', 'song-text');
          text.appendChild(el('small', null, 'Now playing'));
          text.appendChild(el('strong', null, song.title));
          if (song.artist) text.appendChild(el('span', null, song.artist));
          strip.appendChild(text);
          return strip;
        }

        // The board, as the web sign lays it out: the venue and the time, tonight's events, then who's on when.
        function show(data) {
          if (data && data.type === 'clock') { setClock(data.position, data.playing); shownLine = null; drawLyrics(); return; }
          if (!data || data.type !== 'tonight' || !data.venue) return;
          stopFallback();
          venueId = data.venue.id || venueId;
          zone = data.venue.timeZone || zone;
          board.textContent = '';
          var header = el('header');
          header.className = 'with-qr';
          var code = joinCode(data.join || joinLink(venueId));
          if (code) header.appendChild(code);
          var title = el('div');
          title.className = 'title';
          title.appendChild(el('p', 'kicker', 'Tonight'));
          title.appendChild(el('h1', null, data.venue.name || 'Tonight'));
          header.appendChild(title);
          var time = el('p', 'clock', clock());
          time.setAttribute('data-clock', '');
          header.appendChild(time);
          board.appendChild(header);
          var events = data.events || [];
          if (events.length) board.appendChild(el('p', 'events', events.join(' · ')));
          var lineup = data.lineup || [];
          // The venue's picture behind the board, as on Apple TV and Google TV: bright with nothing on, dimmed under a
          // lineup so the names stay readable.
          var photo = typeof data.venue.photo === 'string' && data.venue.photo.indexOf('https://') === 0;
          board.style.backgroundImage = '';
          board.classList.remove('photo');
          if (photo) sharpBackdrop(board, data.venue.photo, lineup.length ? .78 : .45);
          if (!lineup.length) {
            board.appendChild(el('p', 'idle', events.length ? 'The lineup is coming soon.' : 'Nothing on tonight yet.'));
            var coming = (Array.isArray(data.comingUp) ? data.comingUp : []).filter(function (event) {
              return event && typeof event.name === 'string';
            }).slice(0, 4);
            if (coming.length) {
              board.appendChild(el('p', 'kicker coming-kicker', 'Coming up'));
              var next = el('ol', 'coming');
              coming.forEach(function (event) {
                var row = el('li');
                row.appendChild(el('span', 'when', event.when || ''));
                row.appendChild(el('strong', null, event.name));
                next.appendChild(row);
              });
              board.appendChild(next);
            }
          } else {
            var list = el('ol', 'lineup');
            lineup.forEach(function (entry) {
              var row = el('li', entry.state === 'on' || entry.state === 'done' ? entry.state : 'upcoming');
              row.appendChild(el('span', 'time', entry.time || ''));
              // Their pictures, or their initial on a raised circle, as Velvet on Apple TV and Google TV draw them.
              var faces = el('span', 'faces');
              (entry.images || []).slice(0, 2).forEach(function (url) { var img = image(url); if (img) faces.appendChild(img); });
              if (!faces.childNodes.length) faces.appendChild(el('span', 'initial', (entry.name || '?').charAt(0).toUpperCase()));
              row.appendChild(faces);
              // The name, and under it what they do with its symbol (a DJ's headphones, a host's sparkle).
              var who = el('span', 'who');
              who.appendChild(el('strong', null, entry.name || ''));
              if (entry.role && entry.role !== entry.name) {
                var role = el('small', 'role');
                var glyph = roleGlyph(entry.role);
                if (glyph) role.innerHTML = glyph;
                role.appendChild(el('span', null, entry.role));
                who.appendChild(role);
              }
              row.appendChild(who);
              if (entry.state === 'on') {
                var badge = el('span', 'badge');
                badge.innerHTML = GLYPHS.waveform;
                badge.appendChild(el('span', null, 'On now'));
                row.appendChild(badge);
              }
              list.appendChild(row);
            });
            board.appendChild(list);
          }
          var playing = nowPlaying(data.nowPlaying);
          if (playing) board.appendChild(playing);
          var list = Array.isArray(data.posters) ? data.posters : [];
          var mode = data.mode;
          if (mode === 'chat' && !data.chat) mode = 'board';
          if (mode === 'posters' && !list.length && !(Array.isArray(data.social) && data.social.length)) mode = 'board';
          if (mode === 'lyrics' && !(data.lyrics && Array.isArray(data.lyrics.lines) && data.lyrics.lines.length)) mode = 'board';
          if (mode === 'photos' && !cleanPhotos(data.photos).length) mode = 'board';
          setMode(mode);
          lyricsBox.hidden = mode !== 'lyrics';
          photosBox.hidden = mode !== 'photos';
          if (mode === 'photos') showPhotos(data.photos, data.venue.name); else hidePhotos();
          if (mode === 'lyrics') {
            var same = song && data.lyrics.title === song.title && data.lyrics.lines.length === song.lines.length;
            if (same) setClock(data.lyrics.position, data.lyrics.playing); else showLyrics(data.lyrics);
            shownLine = null;
            drawLyrics();
          }
          chat.querySelector('.room').textContent = data.venue.name || '';
          showChat(mode === 'lineup' || mode === 'posters' || mode === 'lyrics' || mode === 'photos' ? null : data.chat);
          fit();
          // The chat wall is only the chat; posters only are only the posters, without the slogans between them.
          var wantsSlogans = mode !== 'chat' && mode !== 'posters' && mode !== 'lyrics' && mode !== 'photos' && data.slogans && typeof data.slogans === 'object';
          slogans(wantsSlogans ? { adult: data.slogans.adult === true, hidden: data.slogans.hidden, slides: data.slogans.slides } : null);
          posters(mode === 'chat' || mode === 'lyrics' || mode === 'photos' ? [] : list);
          social(mode === 'chat' || mode === 'lyrics' || mode === 'photos' ? [] : data.social, data.venue.name);
          postersOnly(mode === 'posters');
        }

        // What the screen is for: the body's class lays it out (see the styles below).
        function setMode(mode) {
          ['lineup', 'chat', 'posters', 'lyrics', 'photos'].forEach(function (name) {
            document.body.classList.toggle('mode-' + name, mode === name);
          });
        }

        // The venue's social profiles for the follow-us slide, cleaned there; a message before the bundle loads leaves them.
        function social(list, venueName) {
          window.velvetSocialWanted = [list, venueName];
          if (window.velvetSocial) window.velvetSocial(list, venueName);
        }

        function postersOnly(on) {
          window.velvetPostersOnlyWanted = on;
          if (window.velvetPostersOnly) window.velvetPostersOnly(on);
        }

        // Upcoming events' posters for the rotation, cleaned there; a message before the bundle loads leaves them for it.
        function posters(list) {
          window.velvetPostersWanted = list;
          if (window.velvetPosters) window.velvetPosters(list);
        }

        // The slogan rotation (bundled below), on while the phone or the web sign's board asks for it. A message that
        // comes before the bundle loads leaves its setting for the bundle to pick up.
        function slogans(setting) {
          window.velvetSlogansWanted = setting;
          if (window.velvetSlogans) window.velvetSlogans.set(setting);
        }

        // The venue's short link (hotmess.social/v/<code>, VenueShortLink), for a phone that sends no join link: the top
        // 47 bits of the venue's UUID in base62. 48 bits fit a JavaScript number exactly.
        function joinLink(id) {
          var hex = (id || '').replace(/-/g, '');
          if (!/^[0-9a-f]{32}$/i.test(hex)) return id ? 'https://hotmess.social/venues/' + encodeURIComponent(id) + '/chat' : null;
          var value = Math.floor(parseInt(hex.slice(0, 12), 16) / 2);
          var alphabet = '0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ';
          var code = '';
          for (var i = 0; i < 8; i++) { code = alphabet.charAt(value % 62) + code; value = Math.floor(value / 62); }
          return 'https://hotmess.social/v/' + code;
        }

        // "Join the room": the QR code, with the Hot Mess mark in the middle that its high error correction reads through.
        function joinCode(link) {
          if (!link || link.indexOf('https://hotmess.social/') !== 0 || typeof window.velvetQR !== 'function') return null;
          var box = el('div', 'join');
          box.setAttribute('aria-hidden', 'true');
          box.innerHTML = window.velvetQR(link);
          var mark = el('img', 'mark');
          mark.src = '/favicon.svg?v=misprint-1'; mark.alt = '';
          box.appendChild(mark);
          return box;
        }

        // The room's chat in the right third, newest at the bottom, as guests see it in Hot Mess; only when the phone
        // sends it.
        function showChat(room) {
          chat.hidden = !room;
          document.body.classList.toggle('with-chat', !!room);
          if (!room) return;
          var pinned = document.getElementById('pinned');
          pinned.hidden = !room.pinned;
          pinned.textContent = '';
          if (room.pinned) { pinned.innerHTML = GLYPHS.pin; pinned.appendChild(el('span', null, room.pinned)); }
          var messages = document.getElementById('messages');
          messages.textContent = '';
          var list = room.messages || [];
          if (!list.length) messages.appendChild(el('li', 'empty', 'Say hi in Hot Mess.'));
          list.forEach(function (message) {
            var row = el('li', message.venue ? 'venue' : null);
            var face = image(message.avatar);
            row.appendChild(face || el('span', 'initial', (message.sender || '?').charAt(0).toUpperCase()));
            // The sender above the bubble, as the room shows it on a phone.
            var bubble = el('div', 'bubble');
            row.appendChild(el('b', null, message.sender || 'Guest'));
            var picture = image(message.photo);
            if (picture) { picture.className = 'photo'; bubble.appendChild(picture); }
            var text = message.text || '';
            if (picture) text = text.replace(/^📷\s*(Photo)?/, '').trim();
            if (text) bubble.appendChild(el('p', null, text));
            row.appendChild(bubble);
            messages.appendChild(row);
          });
        }

        // Leave off the sets that don't fit rather than cutting one in half.
        function fit() {
          var list = board.querySelector('.lineup');
          if (!list) return;
          var rows = list.children;
          for (var i = 0; i < rows.length; i++) rows[i].style.display = '';
          for (var j = 0; j < rows.length; j++) {
            if (rows[j].offsetTop - list.offsetTop + rows[j].offsetHeight > list.clientHeight) rows[j].style.display = 'none';
          }
        }

        // No phone left: the web sign's board for this venue, read again each minute.
        function fallback() {
          showChat(null);
          setMode('board');
          lyricsBox.hidden = true;
          photosBox.hidden = true;
          hidePhotos();
          postersOnly(false);
          if (!venueId || fallbackTimer) return;
          function load() {
            fetch('/venues/' + encodeURIComponent(venueId) + '/display', { cache: 'no-store' })
              .then(function (r) { return r.ok ? r.text() : null; })
              .then(function (html) {
                if (!html || !fallbackTimer) return;
                var next = new DOMParser().parseFromString(html, 'text/html').getElementById('board');
                if (!next) return;
                board.innerHTML = next.innerHTML;
                zone = next.getAttribute('data-zone') || zone;
                fit();
                var mode = next.getAttribute('data-slogans');
                var hidden = [];
                try { hidden = JSON.parse(next.getAttribute('data-slogans-hidden') || '[]'); } catch (e) { hidden = []; }
                var own = null;
                try { own = JSON.parse(next.getAttribute('data-slogans-slides') || 'null'); } catch (e) { own = null; }
                slogans(mode === 'adult' || mode === 'general' ? { adult: mode === 'adult', hidden: hidden, slides: own } : null);
                var list = null;
                try { list = JSON.parse(next.getAttribute('data-posters') || '[]'); } catch (e) { list = []; }
                posters(list);
                var profiles = null;
                try { profiles = JSON.parse(next.getAttribute('data-social') || '[]'); } catch (e) { profiles = []; }
                social(profiles, next.getAttribute('data-venue-name'));
              }).catch(function () {});
          }
          fallbackTimer = setInterval(load, 60000);
          load();
        }
        function stopFallback() { if (fallbackTimer) { clearInterval(fallbackTimer); fallbackTimer = null; } }

        window.addEventListener('resize', fit);
        setInterval(tick, 15000);

        // Velvet on a Samsung TV (Tizen) runs this page in a frame, as /cast/velvet/?screen=tizen, and sends it the same
        // messages a phone sends over Cast, with postMessage, so the Samsung TV and the cast receiver share one renderer.
        // Only the page's own parent is heard; it's told when the page is ready, so it can send the board it has.
        if (window.parent !== window) {
          window.addEventListener('message', function (event) {
            var data = event.source === window.parent ? event.data : null;
            if (data && typeof data === 'object' && typeof data.type === 'string') show(data);
          });
          window.parent.postMessage({ type: 'velvet-receiver-ready' }, '*');
        }
        if (/[?&]screen=tizen(&|$)/.test(location.search)) return;

        if (!window.cast || !cast.framework) return;
        var context = cast.framework.CastReceiverContext.getInstance();
        var options = new cast.framework.CastReceiverOptions();
        options.disableIdleTimeout = true;
        options.skipPlayersLoad = true;
        options.statusText = 'Tonight';
        options.customNamespaces = {};
        options.customNamespaces[NS] = cast.framework.system.MessageType.JSON;
        context.addCustomMessageListener(NS, function (event) { show(event.data); });
        context.addEventListener(cast.framework.system.EventType.SENDER_DISCONNECTED, function () {
          if (context.getSenders().length === 0) fallback();
        });
        context.start(options);
      })();
    </script>
    <script>
      // The join QR code's drawing, bundled for the receiver above: an SVG string at high error correction.
      import qrcode from 'qrcode-generator';
      import { sloganRotation, type SloganRotation } from '../../lib/poster/rotation';
      import { eventPosters } from '../../lib/poster/eventPosters';
      import { socialProfiles } from '../../lib/poster/social';
      (window as unknown as { velvetQR: (text: string) => string }).velvetQR = (text: string) => {
        const qr = qrcode(0, 'H');
        qr.addData(text);
        qr.make();
        return qr.createSvgTag({ cellSize: 4, margin: 2, scalable: true });
      };
      // The slogan slides' rotation, for show() above; off until a message turns it on.
      const receiver = window as unknown as {
        velvetSlogans: SloganRotation; velvetSlogansWanted?: { adult: boolean; hidden?: unknown; slides?: unknown } | null;
        velvetPosters: (list: unknown) => void; velvetPostersWanted?: unknown;
        velvetPostersOnly: (on: boolean) => void; velvetPostersOnlyWanted?: boolean;
        velvetSocial: (list: unknown, venueName?: string | null) => void; velvetSocialWanted?: [unknown, string | null];
      };
      receiver.velvetSlogans = sloganRotation(document.body);
      receiver.velvetSlogans.set(receiver.velvetSlogansWanted ?? null);
      receiver.velvetPosters = (list) => receiver.velvetSlogans.posters(eventPosters(list));
      receiver.velvetPosters(receiver.velvetPostersWanted ?? []);
      receiver.velvetPostersOnly = (on) => receiver.velvetSlogans.postersOnly(on);
      receiver.velvetPostersOnly(receiver.velvetPostersOnlyWanted ?? false);
      receiver.velvetSocial = (list, venueName) => receiver.velvetSlogans.social(socialProfiles(list), venueName);
      receiver.velvetSocial(...(receiver.velvetSocialWanted ?? [[], null]));
    </script>
