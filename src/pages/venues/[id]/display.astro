---
// Digital signage with no sign-in: tonight at a venue, full screen, for a TV's browser, a phone or tablet propped at
// the bar (Guided Access, or Android screen pinning) or a tab cast to a TV. The page re-reads itself once a minute and
// swaps the board in place, so full screen survives. Only what anyone signed out may see (src/lib/venueDisplay.ts).
import '../../../styles/global.css';
import qrcode from 'qrcode-generator';
import { tonight } from '../../../server/publicContent';
import { clock, entryName, entryRole, entryTime, visibleLineup, type VenueTonight } from '../../../lib/venueDisplay';
export const prerender = false;

const id = (Astro.params.id ?? '').toLowerCase();
if (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/.test(id)) return new Response('Not found', { status: 404 });
let data: VenueTonight | null = null;
let status = 200;
try { data = await tonight(id); if (!data) status = 404; } catch { status = 503; }
Astro.response.status = status;
Astro.response.headers.set('Cache-Control', 'private, max-age=30');
Astro.response.headers.set('X-Robots-Tag', 'noindex');
if (status === 503) Astro.response.headers.set('Retry-After', '60');

const now = new Date();
const zone = data?.venue.timeZone ?? 'America/Los_Angeles';
const lineup = data ? visibleLineup(data.lineup) : [];
const qr = qrcode(0, 'M');
qr.addData(`https://hotmess.social/venues/${id}`);
qr.make();
const qrSvg = qr.createSvgTag({ cellSize: 4, margin: 2, scalable: true });
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="theme-color" content="#0d0a0b" />
    <link rel="icon" href="/favicon.svg?v=misprint-1" type="image/svg+xml" sizes="any" />
    <title>{data ? `${data.venue.title} tonight` : 'Tonight'} · Hot Mess</title>
  </head>
  <body>
    <main id="board" data-zone={zone}>
      {status !== 200 ? (
        <p class="idle">{status === 404 ? 'This venue has no display.' : 'Reconnecting…'}</p>
      ) : (
        <>
          <header>
            <div>
              <p class="kicker">Tonight</p>
              <h1>{data!.venue.title}</h1>
            </div>
            <p class="clock" data-clock>{clock(now, zone)}</p>
          </header>
          {data!.events.length > 0 && <p class="events">{data!.events.map((event) => event.name).join(' · ')}</p>}
          {lineup.length === 0 ? (
            <p class="idle">{data!.events.length ? 'The lineup is coming soon.' : 'Nothing on tonight yet.'}</p>
          ) : (
            <ol class="lineup">
              {lineup.map((entry) => (
                <li class={entry.state}>
                  <span class="time">{entryTime(entry, zone)}</span>
                  <span class="faces">
                    {entry.people.filter((person) => person.image).slice(0, 2).map((person) =>
                      <img src={person.image} alt="" loading="lazy" />)}
                  </span>
                  <span class="who">
                    <strong>{entryName(entry)}</strong>
                    {entryRole(entry) && entryRole(entry) !== entryName(entry) && <small>{entryRole(entry)}</small>}
                  </span>
                  {entry.state === 'on' && <span class="badge">On now</span>}
                </li>
              ))}
            </ol>
          )}
          <footer>
            <span class="qr" set:html={qrSvg} />
            <span>Scan for tonight on <b>Hot Mess</b></span>
          </footer>
        </>
      )}
    </main>
    <button id="go-full" type="button" hidden>Tap for full screen</button>
    <script is:inline>
      (function () {
        var board = document.getElementById('board');
        function tick() {
          var el = document.querySelector('[data-clock]');
          if (!el) return;
          try {
            el.textContent = new Intl.DateTimeFormat('en-US', { hour: 'numeric', minute: '2-digit',
              timeZone: board.getAttribute('data-zone') }).format(new Date());
          } catch (e) {}
        }
        // Re-read the page once a minute and swap the board, so full screen and the wake lock stay on.
        function refresh() {
          fetch(location.href, { cache: 'no-store' }).then(function (r) { return r.ok ? r.text() : null; })
            .then(function (html) {
              if (!html) return;
              var next = new DOMParser().parseFromString(html, 'text/html').getElementById('board');
              if (next) { board.innerHTML = next.innerHTML; board.setAttribute('data-zone', next.getAttribute('data-zone')); fit(); }
            }).catch(function () {});
        }
        // Leave off the sets that don't fit rather than cutting one in half.
        function fit() {
          var list = board.querySelector('.lineup');
          if (!list) return;
          var rows = list.children;
          for (var i = 0; i < rows.length; i++) rows[i].style.display = '';
          for (var j = 0; j < rows.length; j++) {
            if (rows[j].offsetTop - list.offsetTop + rows[j].offsetHeight > list.clientHeight) rows[j].style.display = 'none';
          }
        }
        fit();
        window.addEventListener('resize', fit);
        setInterval(tick, 15000);
        setInterval(refresh, 60000);
        // Keep the screen awake where the browser lets a page ask.
        var lock = null;
        function wake() {
          if (!('wakeLock' in navigator) || document.visibilityState !== 'visible') return;
          navigator.wakeLock.request('screen').then(function (l) { lock = l; }).catch(function () {});
        }
        document.addEventListener('visibilitychange', wake);
        wake();
        var root = document.documentElement, button = document.getElementById('go-full');
        var full = root.requestFullscreen || root.webkitRequestFullscreen;
        if (full && !(navigator.standalone)) {
          button.hidden = false;
          setTimeout(function () { button.hidden = true; }, 15000);
          button.addEventListener('click', function () {
            try { var p = full.call(root); if (p && p.catch) p.catch(function () {}); } catch (e) {}
            button.hidden = true;
            wake();
          });
        }
      })();
    </script>
  </body>
</html>

<style is:global>
  html, body { margin: 0; height: 100%; background: #0d0a0b; color: #f6f1f1; overflow: hidden; }
  body { font-family: "Figtree", system-ui, sans-serif; }
  #board { box-sizing: border-box; height: 100%; display: flex; flex-direction: column;
    gap: clamp(10px, 2.2vmin, 32px); padding: max(env(safe-area-inset-top), clamp(16px, 4vmin, 64px))
    max(env(safe-area-inset-right), clamp(16px, 4vmin, 64px)) max(env(safe-area-inset-bottom), clamp(12px, 3vmin, 48px))
    max(env(safe-area-inset-left), clamp(16px, 4vmin, 64px)); }
  header { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; }
  .kicker { margin: 0; font-size: clamp(13px, 2.6vmin, 30px); font-weight: 800; letter-spacing: .18em;
    text-transform: uppercase; color: #ff5a4f; }
  h1 { margin: 0; font-size: clamp(30px, 8vmin, 96px); font-weight: 900; line-height: 1.02; overflow-wrap: anywhere; }
  .clock { margin: 0; font-size: clamp(20px, 5vmin, 56px); font-weight: 700; color: #b9adaf;
    font-variant-numeric: tabular-nums; white-space: nowrap; }
  .events { margin: 0; font-size: clamp(17px, 4vmin, 44px); font-weight: 700; color: #e9dfe0; }
  .lineup { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: clamp(6px, 1.4vmin, 18px);
    flex: 1; min-height: 0; overflow: hidden; }
  .lineup li { display: flex; align-items: center; gap: clamp(10px, 2.4vmin, 28px); padding: clamp(6px, 1.2vmin, 14px)
    clamp(10px, 2vmin, 24px); border-radius: clamp(10px, 2vmin, 22px); }
  .lineup li.on { background: rgba(255, 90, 79, .16); box-shadow: inset 0 0 0 2px rgba(255, 90, 79, .55); }
  .lineup li.done { opacity: .4; }
  .time { flex: 0 0 auto; width: clamp(78px, 17vmin, 210px); font-size: clamp(15px, 3.4vmin, 38px); font-weight: 700;
    color: #b9adaf; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .on .time { color: #ff5a4f; }
  .faces { display: flex; flex: 0 0 auto; }
  .faces img { width: clamp(34px, 6.5vmin, 76px); height: clamp(34px, 6.5vmin, 76px); border-radius: 50%; object-fit: cover;
    border: 2px solid #0d0a0b; }
  .faces img + img { margin-left: -14px; }
  .who { display: flex; flex-direction: column; min-width: 0; flex: 1; }
  .who strong { font-size: clamp(18px, 4.2vmin, 48px); font-weight: 800; white-space: nowrap; overflow: hidden;
    text-overflow: ellipsis; }
  .who small { font-size: clamp(13px, 2.8vmin, 28px); color: #b9adaf; font-weight: 600; }
  .badge { flex: 0 0 auto; background: #ff5a4f; color: #fff; font-weight: 800; font-size: clamp(12px, 2.6vmin, 28px);
    padding: .3em .8em; border-radius: 999px; text-transform: uppercase; letter-spacing: .06em; }
  .idle { flex: 1; display: flex; align-items: center; justify-content: center; margin: 0; text-align: center;
    font-size: clamp(20px, 5vmin, 48px); color: #b9adaf; }
  footer { display: flex; align-items: center; gap: 14px; font-size: clamp(13px, 2.6vmin, 28px); color: #b9adaf; }
  footer b { color: #f6f1f1; }
  .qr { display: block; width: clamp(56px, 12vmin, 140px); height: clamp(56px, 12vmin, 140px); background: #fff;
    border-radius: 8px; overflow: hidden; }
  .qr svg { width: 100%; height: 100%; display: block; }
  #go-full { position: fixed; right: 12px; top: 12px; font: inherit; font-weight: 700; padding: 10px 16px;
    border-radius: 999px; border: 0; background: rgba(255, 255, 255, .14); color: #fff; }
  @media (orientation: landscape) {
    #board { position: relative; }
    .who { flex-direction: row; align-items: baseline; gap: .7em; }
    footer { position: absolute; right: max(env(safe-area-inset-right), clamp(16px, 4vmin, 64px));
      bottom: max(env(safe-area-inset-bottom), clamp(12px, 3vmin, 48px)); flex-direction: column-reverse;
      align-items: flex-end; gap: 6px; }
    .lineup { padding-right: clamp(80px, 16vmin, 180px); }
  }
  @media (orientation: portrait) { .time { width: clamp(64px, 20vw, 160px); } }
</style>
