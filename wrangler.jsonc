{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hotmess-social",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client"
  },
  // Astro's Cloudflare adapter stores sessions in the SESSION KV binding. Naming the namespace here stops each
  // deploy from trying to create "hotmess-social-session" again, which fails once it exists.
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "460daca6aea64a7880374bd34fd8b047"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "PUBLIC_CONTENT_API_BASE": "https://api.next.audiencekit.com",
    "PUBLIC_CONTENT_HOST": "hotmess.admin.next.audiencekit.com",
    "PUBLIC_SITE_ORIGIN": "https://hotmess.social"
  }
}
